# 강사가 나눠 준 키를 넣고 파일 이름을 .env 로 바꿉니다
# day1 · day2가 이 파일 하나를 함께 씁니다 (common/llm.py가 읽습니다)
ANTHROPIC_API_KEY=sk-ant-...

# 기본 모델 — 일반 실습은 Haiku(빠르고 쌈)를 쓰고, 고급 모델이 필요할 때만 MODEL_ADVANCED(Sonnet)를 씁니다
# 강의 당일 쓸 수 있는 모델 이름으로 확인해 바꿉니다
MODEL=claude-haiku-4-5-20251001
MODEL_ADVANCED=claude-sonnet-5-5

# 1로 두면 API를 부르지 않고 흐름만 확인합니다 (키가 없을 때 · 강사 리허설용)
LLM_MOCK=0

# day2 임베딩: st = 한국어 특화 공개 모델 jhgan/ko-sroberta-multitask (기본) · hash = 내려받기 없는 간이 벡터 (인터넷이 막혔을 때)
EMBED=st
