#!/usr/bin/env python3
"""사실만 센다 — 판단하지 않는다. 출력은 KEY: value 줄. 스킬은 이 값을 다시 계산하지 않는다.

    my-facts [경로]      (생략하면 /tmp/my-demo)

읽는 파일
    rules.csv      지급 기준   — 항목,한도,단위        예: 숙박,120000,원/박
    claims.csv     청구 원본   — 청구번호,이름,출장지,귀임일,청구일,숙박일수,숙박비,출장일수,일비,영수증
    decisions.csv  사람의 결정 — 청구번호,결정,사유,결정자
"""
import csv
import os
import sys
from datetime import date

PROTO = 1           # 출력 형식 버전 — 형식을 바꾸면 올린다


def read_csv(path):
    """CSV 파일을 [{열 이름: 값}, ...] 리스트로 읽는다."""
    with open(path, encoding="utf-8") as f:
        return list(csv.DictReader(f))


def load(path):
    """세 파일을 읽어 (기준 dict, 청구 리스트, 이미 결정한 청구번호 리스트)를 돌려준다."""
    rules = {}                                      # 예: {"숙박": 120000.0, "일비": 30000.0, ...}
    for row in read_csv(os.path.join(path, "rules.csv")):
        rules[row["항목"]] = float(row["한도"])

    claims = read_csv(os.path.join(path, "claims.csv"))

    decided = []                                    # 예: ["C-005"]
    for row in read_csv(os.path.join(path, "decisions.csv")):
        decided.append(row["청구번호"])
    return rules, claims, decided


def over(amount, limit):
    """한도를 넘은 만큼. 넘지 않았으면 0."""
    if amount > limit:
        return amount - limit
    return 0


def main():
    if len(sys.argv) > 1:
        path = os.path.abspath(sys.argv[1])
    else:
        path = os.path.abspath("/tmp/my-demo")

    try:
        rules, claims, decided = load(path)
    except (OSError, KeyError, ValueError) as e:
        print(f"ERROR: 데이터를 읽지 못했다 — {e}")
        return 1

    print(f"MY_FACTS_PROTO: {PROTO}")
    print(f"DEMO_DIR: {path}")
    print(f"CLAIM_COUNT: {len(claims)}")

    flagged = []                                    # 기준에 하나라도 걸린 청구
    for c in claims:
        cid = c["청구번호"]
        nights = int(c["숙박일수"])
        days = int(c["출장일수"])

        # 숙박 한도 — 서울 · 제주는 따로
        if c["출장지"] in ("서울", "제주"):
            per_night = rules["숙박_서울제주"]
        else:
            per_night = rules["숙박"]
        lodging_limit = int(per_night * nights)
        lodging_over = over(int(c["숙박비"]), lodging_limit)

        # 일비 한도
        perdiem_over = over(int(c["일비"]), int(rules["일비"] * days))

        # 귀임일부터 청구일까지 며칠 걸렸나, 그중 정산 기한을 넘긴 날
        days_to_claim = (date.fromisoformat(c["청구일"]) - date.fromisoformat(c["귀임일"])).days
        late_days = over(days_to_claim, int(rules["정산기한"]))

        has_receipt = c["영수증"] == "있음"

        print(f"{cid}.WHO: {c['이름']} {c['출장지']}")
        print(f"{cid}.LODGING_LIMIT: {lodging_limit}")
        print(f"{cid}.LODGING_OVER: {lodging_over}")
        print(f"{cid}.PERDIEM_OVER: {perdiem_over}")
        print(f"{cid}.DAYS_TO_CLAIM: {days_to_claim}")
        print(f"{cid}.LATE_DAYS: {late_days}")
        if has_receipt:
            print(f"{cid}.RECEIPT: yes")
        else:
            print(f"{cid}.RECEIPT: no")
        if cid in decided:
            print(f"{cid}.DECIDED: yes")
        else:
            print(f"{cid}.DECIDED: no")

        if lodging_over > 0 or perdiem_over > 0 or late_days > 0 or not has_receipt:
            flagged.append(cid)

    if flagged:
        print("FLAGGED: " + " ".join(flagged))
    else:
        print("FLAGGED: none")
    print("MY_FACTS_OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
